# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- AI providers ---
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=

# Optional: override model names when a provider retires a model
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
GROQ_MODEL=llama-3.3-70b-versatile

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only used by scripts/seed_simulations.mjs on your own machine. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Benchmark ---
# Any long random string. Lets benchmark/run.mjs call the API without logging in.
# Generate one with:  node -e "console.log(crypto.randomUUID())"
BENCHMARK_SECRET=
